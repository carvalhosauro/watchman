#!/usr/bin/env bash
# Pre-commit: gofmt staged Go files (auto-fix + restage), then lint + test.
set -e

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)

if [ -n "$STAGED_GO" ]; then
  gofmt -w $STAGED_GO
  echo "$STAGED_GO" | xargs git add
  echo "✓ gofmt: $(echo "$STAGED_GO" | wc -l | tr -d ' ') file(s)"
fi

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run
else
  echo "⚠ golangci-lint not found; skipping lint"
fi

go test ./...
