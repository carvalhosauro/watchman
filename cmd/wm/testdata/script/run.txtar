# Full run glance against the mock upstreams: one verdict per held ticker.

cp wallet_seed wallet
wm run

# dated header (today, UTC)
stdout 'watchman'
stdout '\d{4}-\d{2}-\d{2}'

# PETR4: abnormal move -> LOOK, reason names the move
stdout 'LOOK.*PETR4'
stdout 'PETR4.*moved'

# MXRF11: calm -> ignore, reason says quiet
stdout 'ignore MXRF11'
stdout 'MXRF11.*quiet'

# VALE3: fresh CVM news -> LOOK, reason names the news
stdout 'LOOK.*VALE3'
stdout 'VALE3.*news'

# XPTO3: no usable price data -> ignore
stdout 'ignore XPTO3'
stdout 'XPTO3.*no price data'

# empty wallet -> the add hint
env WATCHMAN_WALLET=$WORK/empty
wm run
stdout 'No tickers'
stdout 'wm wallet add'

-- wallet_seed --
PETR4
MXRF11
VALE3
XPTO3
