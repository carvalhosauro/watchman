# Full run glance against the mock upstreams: ranked, with a failure row.

cp wallet_seed wallet
wm run
stdout 'watchman'
stdout '\d{4}-\d{2}-\d{2}'

# PETR4: abnormal move -> LOOK
stdout 'LOOK.*PETR4'
# XPTO3: no usable price data -> No data failure row
stdout 'XPTO3.*No data'

# detail mode lists every signal for a single ticker
wm run PETR4 --detail
stdout 'PETR4'

# empty wallet -> the add hint
env WATCHMAN_WALLET=$WORK/empty
wm run
stdout 'No tickers'

-- wallet_seed --
PETR4
MXRF11
XPTO3
