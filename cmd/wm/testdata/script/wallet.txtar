# Wallet CRUD, dedupe, normalization, comments/blanks, arg validation.

# missing wallet -> empty list, exit 0
wm wallet list
! stdout .

# add lowercases -> stored uppercase, one per line
wm wallet add petr4
cmp wallet want_petr4

# dedupe: adding the same ticker again does not duplicate
wm wallet add PETR4
cmp wallet want_petr4

# append a second ticker, preserving order
wm wallet add mxrf11
cmp wallet want_two

# remove drops the ticker
wm wallet remove PETR4
cmp wallet want_mxrf

# removing a ticker that is not present is a no-op, exit 0
wm wallet remove zzzz9
cmp wallet want_mxrf

# arg validation: add needs at least one ticker
! wm wallet add

# multi-add: several tickers in one call, deduped and uppercased
env WATCHMAN_WALLET=$WORK/multi
wm wallet add petr4 VALE3 petr4
cmp multi want_multi

# default subcommand: bare `wm wallet` lists
wm wallet
stdout '^PETR4$'
stdout '^VALE3$'

# clear requires --yes; without it the wallet is untouched
! wm wallet clear
stderr 'yes'
cmp multi want_multi

# clear --yes empties the wallet
wm wallet clear --yes
wm wallet list
! stdout .

# comments, blank lines, surrounding spaces, lowercase are all handled on read
env WATCHMAN_WALLET=$WORK/seeded
cp seed $WORK/seeded
wm wallet list
stdout '^PETR4$'
stdout '^ITUB4$'
stdout '^MXRF11$'

-- want_petr4 --
PETR4
-- want_two --
PETR4
MXRF11
-- want_mxrf --
MXRF11
-- want_multi --
PETR4
VALE3
-- seed --
# my fiis

petr4
  itub4
MXRF11
